# ─────────────────────────────────────────────────────────────────────────────
# School SaaS Platform — environment variable reference
#
# Copy this file to .env and fill in the values for your environment.
# Never commit a .env file with real secrets to version control.
#
# Sections
#   1. Django core
#   2. Database (PostgreSQL)
#   3. Multi-tenancy
#   4. Application
#   5. Next.js Frontend
#   6. Celery / Redis
#   7. AWS S3 + CloudFront  (only required when USE_S3=true)
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. Django core ────────────────────────────────────────────────────────────

# Environment tier: development | staging | production
# Controls USE_S3 default, security headers, and upload size limits.
DJANGO_ENV=development

# Generate a unique value with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-secret-key

# Set to True only during local development — never in staging or production.
DEBUG=False

# Comma-separated list of host/domain names Django will serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Override USE_S3 independently of DJANGO_ENV.
# Defaults to true when DJANGO_ENV is staging or production; false otherwise.
# USE_S3=false


# ── 2. Database (PostgreSQL) ──────────────────────────────────────────────────

# django-tenants requires its custom backend — do not change this.
DATABASE_ENGINE=django_tenants.postgresql_backend

DATABASE_NAME=schoolsaas_db
DATABASE_USER=schoolsaas_user
DATABASE_PASSWORD=change-me-strong-password
# Use 'db' when running inside Docker Compose; use 'localhost' for a local install.
DATABASE_HOST=db
DATABASE_PORT=5432


# ── 3. Multi-tenancy ─────────────────────────────────────────────────────────

# Root domain used to route tenant subdomains (e.g. school.pinewood.co.zm).
BASE_DOMAIN=localhost

# Domain used by django-tenant-users for the public schema user management.
# Should match BASE_DOMAIN in most deployments.
TENANT_USERS_DOMAIN=localhost


# ── 4. Application ────────────────────────────────────────────────────────────

# Public base URL of the application (used in emails, Celery tasks, etc.).
BASE_URL=http://localhost:8000

# Key for encrypting QuickBooks credentials/tokens at rest (core.db_fields).
# Any stable string; falls back to SECRET_KEY if unset. Do not rotate without
# re-encrypting existing rows.
FIELD_ENCRYPTION_KEY=

# Set to False to disable automatic QuickBooks sync background tasks.
QUICKBOOKS_AUTO_SYNC_ENABLED=True
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=

# Comma-separated list of allowed origins for the Next.js portal SPA (CORS).
# Required in production — browser preflight requests for /api/portal/... are
# rejected unless the frontend origin is listed here.
# The system also allows all subdomains of BASE_DOMAIN as a fallback, but setting
# this explicitly is strongly recommended to avoid silent misconfiguration.
# Example: PORTAL_CORS_ORIGINS=https://app.school.com,https://admin.school.com
PORTAL_CORS_ORIGINS=


# ── 5. Next.js Frontend ───────────────────────────────────────────────────────

# (These are set at build time and baked into the Next.js bundle as NEXT_PUBLIC_* vars.
#  They are NOT used by Django.)

# Public API base URL used by the frontend to make requests.
# Must be accessible from client browsers.
# Development: http://localhost:8000
# Production: https://api.yourdomain.com (or a school's custom domain)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Generic application name shown as a fallback while school config loads.
# The actual school name is fetched from the backend /api/school/config/ endpoint.
# Keep this generic to support multi-tenant deployments.
NEXT_PUBLIC_APP_NAME=School Portal

# Client app identifier; sent as X-Client-App header to the backend API.
# Must be registered in Configuration → Manage Clients within each school's admin.
# For a reusable frontend across multiple schools, use a generic identifier like:
#   generic-school-portal-web
# For a dedicated single-school instance, use a school-specific identifier like:
#   pinewood-portal-web
# The backend validates and can version-lock each client per school.
NEXT_PUBLIC_CLIENT_APP=generic-school-portal-web

# Semantic version of the frontend; sent as X-Client-App-Version header.
# The backend can enforce a minimum supported version and refuse older clients.
NEXT_PUBLIC_CLIENT_APP_VERSION=0.1.0


# ── 6. Celery / Redis ─────────────────────────────────────────────────────────

# Redis URL for the Celery task broker.
# Use 'redis://redis:6379/0' inside Docker Compose; 'redis://localhost:6379/0' otherwise.
CELERY_BROKER_URL=redis://redis:6379/0

# Redis URL for storing Celery task results.
CELERY_RESULT_BACKEND=redis://redis:6379/0


# ── 7. AWS S3 + CloudFront ────────────────────────────────────────────────────
# Required when USE_S3=true (i.e. DJANGO_ENV=staging or production, or USE_S3=true).
#
# Architecture:
#   public  bucket  ──OAC──▶  public  CloudFront distribution  (unsigned URLs)
#   private bucket  ──OAC──▶  private CloudFront distribution  (signed URLs)
#
# Both buckets must have S3 Block Public Access enabled.
# Objects are served exclusively through CloudFront via Origin Access Control.

# AWS region where both S3 buckets live.
AWS_S3_REGION_NAME=ap-southeast-1

# AWS credentials — leave unset on AWS infrastructure to use the IAM instance/task role.
# Only set these when running outside AWS (CI, local with real buckets, etc.).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# S3 bucket names (must already exist; created outside Terraform/manually).
# Replace with your actual bucket names.
# Example: schoolsaas-prod-public, schoolsaas-prod-private
AWS_PUBLIC_BUCKET_NAME=<your-public-bucket>
AWS_PRIVATE_BUCKET_NAME=<your-private-bucket>

# CloudFront distribution domains (without 'https://', no trailing slash).
# e.g. d1a2b3c4xyz.cloudfront.net  — or a custom CNAME alias.
AWS_PUBLIC_CLOUDFRONT_DOMAIN=<public-distribution>.cloudfront.net
AWS_PRIVATE_CLOUDFRONT_DOMAIN=<private-distribution>.cloudfront.net

# ── CloudFront signing key setup (modern Key Groups — NOT legacy key pairs) ──
#
# AWS no longer issues PEM files for CloudFront. You generate the key yourself,
# upload only the PUBLIC half to AWS, and keep the PRIVATE half on your server.
#
# Step 1 — Generate a 2048-bit RSA private key (run once on a secure machine):
#
#   openssl genrsa -out cloudfront_private_key.pem 2048
#
# Step 2 — Derive the public key from it:
#
#   openssl rsa -pubout -in cloudfront_private_key.pem -out cloudfront_public_key.pem
#
# Step 3 — Upload the PUBLIC key to AWS:
#   CloudFront console → Security → Public keys → Add public key
#   Paste the contents of cloudfront_public_key.pem
#   Then: Security → Key groups → Create key group → attach the public key
#   Then: Distribution → Behaviors → edit → Restrict viewer access → attach key group
#
# Step 4 — Note the Public Key ID shown in the console (looks like K1A2B3C4D5E6F7).
#   That value goes into CLOUDFRONT_KEY_ID below.
#   The cloudfront_private_key.pem file goes into CLOUDFRONT_PRIVATE_KEY_FILE (or its
#   PEM contents, newlines escaped as \n, go into CLOUDFRONT_PRIVATE_KEY).
#
# Security rules for the private key:
#   DO     store it in a secrets manager, vault, or mounted Docker/K8s secret
#   DO     restrict file permissions: chmod 400 cloudfront_private_key.pem
#   DO NOT commit it to Git
#   DO NOT bake it into a Docker image
#   DO NOT put it in settings.py
#
# Docker Compose example (mount as a read-only secret):
#   volumes:
#     - ./secrets/cloudfront_private_key.pem:/run/secrets/cf_key.pem:ro
#   Then set: CLOUDFRONT_PRIVATE_KEY_FILE=/run/secrets/cf_key.pem

# Public Key ID from the CloudFront console (Security → Public keys).
# This identifies which key was used to sign a URL so CloudFront can verify it.
CLOUDFRONT_KEY_ID=<public-key-id-from-cloudfront-console>

# Provide the RSA private key via ONE of the two options below (not both).
# CLOUDFRONT_PRIVATE_KEY takes precedence if both are set.
#
# Option A — inline PEM (useful for secrets managers that inject env vars):
#   Escape newlines as \n so the entire PEM fits on one line.
# CLOUDFRONT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----
#
# Option B — mounted file path (preferred for Docker / Kubernetes):
#   When using docker-compose.yml, this is set automatically via the 'secrets:'
#   block — do NOT set it here as well or the env_file value will override it.
# CLOUDFRONT_PRIVATE_KEY_FILE=/run/secrets/cloudfront_private_key

# Lifetime of CloudFront signed URLs for private assets, in seconds.
# Default 3600 (1 hour). Reduce for highly sensitive documents (e.g. 300 = 5 min).
CLOUDFRONT_SIGNED_URL_EXPIRY=3600
