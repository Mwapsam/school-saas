# ─────────────────────────────────────────────────────────────────────────────
# Next.js Frontend Configuration
#
# These variables are baked into the Next.js bundle at build time and made
# available to the browser as NEXT_PUBLIC_* variables.
#
# School-specific branding (name, logo, colors, contact info) is loaded
# dynamically from the backend at runtime and is NOT configured here.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL.
# Used by both the Next.js server-side proxy and the browser client.
# The browser sends requests to /api/* on its own origin, which Next.js
# proxies to this target server-side (no CORS needed for same-origin requests).
# No trailing slash.
# Examples:
#   Development:    http://localhost:8000
#   Production:     https://api.school.com
#   Multi-tenant:   https://api.schoolsaas.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Generic application name shown as a fallback before school config loads.
# Once the app initializes, the actual school name is fetched from the backend
# and displayed in the UI. This is only visible briefly during page load.
# Keep this generic for multi-tenant deployments.
# Examples:
#   Single school:   "Pinewood Portal"
#   Multi-tenant:    "School Portal"
NEXT_PUBLIC_APP_NAME=School Portal

# Client application identifier sent as X-Client-App header.
# Must be registered in the school's Configuration → Manage Clients section.
# For single-school deployments, use a school-specific identifier.
# For multi-tenant deployments, use a generic identifier that works for all schools.
# Examples:
#   Single school:   "pinewood-portal-web"
#   Multi-tenant:    "generic-school-portal-web"
NEXT_PUBLIC_CLIENT_APP=generic-school-portal-web

# Semantic version of this frontend build.
# Sent as X-Client-App-Version header; the backend can enforce minimum versions
# to ensure clients stay compatible with the API.
NEXT_PUBLIC_CLIENT_APP_VERSION=0.1.0
