# Django backend URL — used ONLY by the Next.js server-side proxy (next.config.mjs).
# The browser never calls this directly; it sends requests to /api/* on its own
# origin, which Next.js proxies to this target server-side (no CORS needed).
# No trailing slash.
# Dev:        http://localhost:8000
# Production: https://portal2.pinewoodschoolzambia.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# App name shown in the UI.
NEXT_PUBLIC_APP_NAME=Pinewood Portal
